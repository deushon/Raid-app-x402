# 0.0.0.0 — слушать на всех интерфейсах (доступ по IP сервера). 127.0.0.1 — только с этой машины.
HOST=0.0.0.0
PORT=3000

# PostgreSQL (teleoperator accounts + persisted robot registry table `robots`). If unset, /api/teleoperator and /teleoperator UI are disabled; robots are in-memory only.
# Local npm run + compose postgres only: use localhost:5434
# Full stack "docker compose up" (app + postgres): compose overrides DATABASE_URL for the app container.
DATABASE_URL=postgres://x402:x402@localhost:5434/x402raid
# Только для интеграционных тестов (npm test). НЕ задавайте на сервере с боевым Postgres из compose:
# если TEST_DATABASE_URL указывает на тот же URI, что и проброшенный порт 5434, тесты выполнят TRUNCATE — сотрутся роботы, операторы, grants.
# TEST_DATABASE_URL=postgres://x402:x402@localhost:5434/x402raid
# JWT for teleoperator session cookie (required when DATABASE_URL is set). In production set a long random secret.
TELEOPERATOR_JWT_SECRET=change-this-teleoperator-jwt-secret
# Optional: e.g. 7d, 24h, 3600s
TELEOPERATOR_JWT_EXPIRES_IN=7d
# Optional bcrypt cost (default 10)
# TELEOPERATOR_BCRYPT_ROUNDS=10
# Флаг Secure у cookie телеоператора: auto (по умолчанию), always, never.
# При NODE_ENV=production раньше всегда ставился Secure=true — браузер не сохранял cookie по обычному HTTP (логин «молчал»).
# TELEOPERATOR_COOKIE_SECURE=auto
# За reverse proxy (nginx) с HTTPS: доверять X-Forwarded-Proto, число — хопы (часто 1)
# TRUST_PROXY=1

X402_PRIVATE_KEY=replace-with-private-key
X402_WALLET_ID=wallet-identifier
X402_GATEWAY_URL=https://api.corbits.dev
X402_PAYMENT_ENDPOINT=/v1/payments
X402_PAYMENT_TIMEOUT_MS=10000
X402_PAYMENT_PROVIDER=gateway
X402_CONFIRM_ATTEMPTS=5
X402_CONFIRM_DELAY_MS=2000
# Solana RPC: helius (recommended), public, or custom
SOLANA_RPC_PROVIDER=helius
HELIUS_API_KEY=your-helius-api-key
# Fallback RPC (не mainnet-beta — даёт 403). Helius настраивается в админке или HELIUS_API_KEY
X402_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
X402_SOLANA_COMMITMENT=confirmed
X402_SOLANA_MIN_CONFIRMATIONS=1
# Base64 or JSON secret key; defaults to X402_PRIVATE_KEY when omitted
X402_SOLANA_SECRET_KEY=

COMMAND_DANCE_STRATEGY=lowest_price
COMMAND_BUY_COLA_STRATEGY=closest

PRICING_MARKUP_PERCENT=10

ROBOT_HEALTH_TIMEOUT_MS=5000
ROBOT_COMMAND_TIMEOUT_MS=8000
ROBOT_HEALTH_ENDPOINT=/health
ROBOT_SECURE_HEALTH_ENDPOINT=/helth

# Shared secret for fleet robots: Bearer or X-Robot-Fleet-Secret on POST /api/robots/enroll and (with admin) mutating /api/robots.
# Generate a long random value; embed the same on each robot for self-registration.
# ROBOT_FLEET_ENROLLMENT_SECRET=

# Optional: RAID authenticates to the robot when POSTing allowlist to operatorRegistryUrl (see docs/ROBOT_OPERATOR_SYNC.md).
# RAID_TO_ROBOT_SECRET=

# mDNS: advertise HTTP on LAN as <MDNS_HOSTNAME>.local (UDP 5353; Docker often needs host network).
# MDNS_ENABLED=true
# MDNS_HOSTNAME=raid-app

# Teleop: WebSocket proxy to ROSBridge (same HTTP port as app). Disabled if TELEOP_WS_ENABLED=false or 0.
# TELEOP_WS_ENABLED=true
# Max incoming/outgoing WS frame payload (bytes)
# TELEOP_MAX_MESSAGE_BYTES=16777216
# Timeout per attempt to open ws://rosbridgeHost:rosbridgePort from server to robot (LAN)
# TELEOP_ROSBRIDGE_CONNECT_TIMEOUT_MS=10000
# Attempts per connect wave + delay between attempts (initial connect and each reconnect wave)
# TELEOP_ROSBRIDGE_CONNECT_ATTEMPTS=3
# TELEOP_ROSBRIDGE_RECONNECT_DELAY_MS=2000
# After rosbridge was up then dropped: how many full connect waves to try while client WS still open
# TELEOP_ROSBRIDGE_DROP_RECONNECT_ATTEMPTS=3
# Delay closing teleop_sessions row after client disconnect or final rosbridge failure (ms); 0 = immediate
# TELEOP_SESSION_END_GRACE_MS=120000
# Исходящий WS к rosbridge: проброс id телеоператора (JWT sub) и логина на робот.
# Заголовки X-Teleoperator-Id, X-Teleoperator-Login и query teleoperator_id, teleoperator_login.
# Отключите, если прокси/rosbridge ломается на query или нестандартных заголовках (false / 0).
# TELEOP_FORWARD_OPERATOR_HEADERS=true
# TELEOP_FORWARD_OPERATOR_QUERY=true
# HTTP reverse proxy /api/teleop/robots/:id/dataset/* → robot dataset server (connect + body timeout, ms)
# TELEOP_DATASET_PROXY_TIMEOUT_MS=300000

# Peaq DID claim for teleop help (Agung dev). POST …/teleop/help may return peaq_claim; иначе GET …/peaq/claim?helpRequestId=. См. docs/RAID_APP_PEAQ_CLAIM_SPEC.md
# При PEAQ_ENABLED=true без PEAQ_HTTP_BASE_URL / PEAQ_WSS_BASE_URL подставляются дефолты Agung (OnFinality + wss-async.agung.peaq.network) — см. src/config.js.
# PEAQ_MACHINE_DID_NAME и PEAQ_MACHINE_EVM_ADDRESS — с машины после onboard на Agung (иначе did.read не вернёт документ).
PEAQ_ENABLED=true
# PEAQ_HTTP_BASE_URL=https://peaq-agung.api.onfinality.io/public
# PEAQ_WSS_BASE_URL=wss://wss-async.agung.peaq.network
PEAQ_MACHINE_DID_NAME=raid_machine_dev
PEAQ_MACHINE_EVM_ADDRESS=0x0000000000000000000000000000000000000000
PEAQ_NETWORK=peaq-agung
PEAQ_CLAIM_SYNC_TIMEOUT_MS=8000

# Разовый онбординг machine DID на Agung (скрипт npm run peaq:onboard). НЕ коммить ключ в репозиторий.
# PEAQ_ONBOARD_EVM_PRIVATE_KEY=
# PEAQ_ONBOARD_MACHINE_NAME=raid_m_custom   # опционально; иначе случайное raid_m_<hex>

# Запрос тестовых AGNG через API того же крана, что на docs.peaq.xyz (npm run peaq:faucet) — обход CORS в браузере.
# PEAQ_FAUCET_ADDRESS=0x...
# PEAQ_FAUCET_APIKEY=   # если Peaq сменит ключ в виджете доков — скопировать из исходника страницы (поле APIKEY)
# PEAQ_FAUCET_URL=https://dev-peaq-faucet-service.cisys.xyz/get-test-tokens
# PEAQ_FAUCET_TIMEOUT_MS=180000

# Admin panel: form login at /ui → JWT in httpOnly cookie admin_session (POST /api/admin/login).
# Same pair as HTTP Basic for /api/admin/*. Not the same as teleoperator login (PostgreSQL).
# Save .env as UTF-8 without BOM if the first variable seems ignored; use quotes if password contains #.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Sign admin_session JWT. In production set explicitly (or reuse TELEOPERATOR_JWT_SECRET).
# ADMIN_SESSION_SECRET=
# Session lifetime (default 8h), e.g. 24h, 3600s
# ADMIN_SESSION_EXPIRES_IN=8h
# Cookie Secure: auto (default), always, never — same idea as TELEOPERATOR_COOKIE_SECURE
# ADMIN_COOKIE_SECURE=auto

# AI Agent Configuration (for RAID mode executor selection)
AI_AGENT_STRATEGY=smart
# Options: smart, lowest_price, closest, fastest
# N8N Integration (optional)
N8N_WEBHOOK_URL=
# Example: https://your-n8n-instance.com/webhook/robot-selection

