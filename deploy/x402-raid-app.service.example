# Example systemd unit for running in the background without Docker.
# 1. sudo cp deploy/x402-raid-app.service.example /etc/systemd/system/x402-raid-app.service
# 2. Edit WorkingDirectory, User, ExecStart (path to node: which node), EnvironmentFile if needed.
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now x402-raid-app
# 4. sudo systemctl status x402-raid-app
#
# mDNS (MDNS_ENABLED=true): needs multicast UDP 5353; check firewall if it fails.
# Docker usually needs network_mode: host on the app service for mDNS.

[Unit]
Description=x402 Raid App (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=deploy
WorkingDirectory=/opt/x402_raid_app
EnvironmentFile=/opt/x402_raid_app/.env
# Use full path to node (nvm: ~/.nvm/versions/node/v22.x.x/bin/node)
ExecStart=/usr/bin/node /opt/x402_raid_app/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
